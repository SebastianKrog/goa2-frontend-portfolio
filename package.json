{
  "name": "goa2-temp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run models:prepare",
    "prebuild": "npm run models:prepare",
    "models:prepare": "node scripts/prepare-model-assets.mjs",
    "models:bundle": "node scripts/create-model-bundle.mjs",
    "test:models": "node --test scripts/prepare-model-assets.test.mjs",
    "dev": "vite",
    "check:models": "node scripts/check-model-assets.mjs",
    "sync:translations": "node scripts/sync-translations.mjs",
    "model:convert": "node scripts/model-pipeline/convert-painted-hero.mjs",
    "model:convert-batch": "node scripts/model-pipeline/batch-convert-painted-heroes.mjs",
    "model:inspect-obj": "node scripts/model-pipeline/inspect-obj-base.mjs",
    "model:inspect": "node scripts/model-pipeline/inspect-glb.mjs",
    "model:remove-base": "node scripts/model-pipeline/remove-obj-base.mjs",
    "model:reshape-ground": "node scripts/model-pipeline/reshape-obj-ground.mjs",
    "model:render-thumbnails": "node scripts/model-pipeline/render-glb-thumbnails.mjs",
    "model:simplify": "node scripts/model-pipeline/simplify-obj.mjs",
    "build": "npm run check:models && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "maath": "^0.10.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "three": "^0.184.0",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.29.1",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.75.0"
  }
}
