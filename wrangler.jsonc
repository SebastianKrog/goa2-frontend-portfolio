{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goa2-frontend",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "BACKEND_ORIGIN": "https://backend.example.com"
  }
}
