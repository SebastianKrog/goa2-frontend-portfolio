# Cloudflare Workers Assets reads this file from the root of the built assets
# directory. Without it every file is served `max-age=0, must-revalidate`, so a
# reload re-requests all ~365 MB of art and models just to collect 304s.

# Vite fingerprints these: the filename changes whenever the bytes do.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Art, models and translations are not fingerprinted, so a long max-age is also
# how long a stale copy survives a deploy: a day of silence, then a month of
# serve-now-refresh-in-background.
/models/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/cards/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/hero/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/hero-cards/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/hero-images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/map/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/mats/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/goa2-translations/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
